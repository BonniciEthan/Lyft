{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gym Tracker Local",
  "mainBinaryName": "gym-tracker-local",
  "version": "1.0.0",
  "identifier": "com.personal.gymtracker.local",
  "build": {
    "beforeDevCommand": "npm run dev:local",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build:local",
    "frontendDist": "../dist-local"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Gym Tracker",
        "width": 1100,
        "height": 800,
        "minWidth": 400,
        "minHeight": 700,
        "resizable": true,
        "center": true,
        "backgroundColor": "#080A0F"
      }
    ]
  },
  "bundle": {
    "targets": ["deb", "appimage"],
    "shortDescription": "Minimal personal gym tracker (offline)",
    "longDescription": "Standalone gym tracker. Everything is stored on this computer; no account or server needed."
  }
}
