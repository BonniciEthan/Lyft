{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lyft",
  "version": "1.1.0",
  "identifier": "com.personal.lyft",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Lyft",
        "width": 1100,
        "height": 800,
        "minWidth": 400,
        "minHeight": 700,
        "resizable": true,
        "center": true,
        "backgroundColor": "#080A0F"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "category": "Utility",
    "shortDescription": "Minimal personal gym tracker",
    "longDescription": "Local-first gym tracker that syncs manually with a self-hosted Lyft server.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
